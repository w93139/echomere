# Local SQLite database. Relative paths are resolved from the repository root.
DATABASE_URL="file:./dev.db"

# Server settings
PORT=3001
CORS_ORIGINS="http://localhost:3000"
JWT_SECRET="replace-with-a-long-random-string"
# Secret-file alternative for Docker/Kubernetes: JWT_SECRET_FILE=/run/secrets/jwt_secret
# Give every allowed identity a unique code. Keep this server-side only.
AUTH_LOGIN_CODES_JSON='{"member@example.com":"replace-with-a-unique-long-code"}'
# Secret-file alternative: AUTH_LOGIN_CODES_JSON_FILE=/run/secrets/login_codes
TRUST_PROXY=0
ALLOW_TEST_PLAN_SWITCHING=false

# External API access is disabled unless explicitly enabled.
LLM_ENABLED=false
LLM_API_KEY=""
# Secret-file alternative: LLM_API_KEY_FILE=/run/secrets/llm_api_key
LLM_BASE_URL="https://api.moonshot.cn/v1"
LLM_ALLOWED_HOSTS="api.moonshot.cn"
LLM_MODEL="moonshot-v1-8k"
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS=1024
LLM_MAX_OUTPUT_CHARS=20000
LLM_DAILY_USER_LIMIT=20
LLM_DAILY_GLOBAL_LIMIT=500
LLM_MAX_CONCURRENCY=4
