# Leave empty to use the same-origin /api proxy from the browser.
# Every NEXT_PUBLIC_* value is shipped to browsers. Never put an API key here.
NEXT_PUBLIC_API_BASE_URL=""
NEXT_PUBLIC_USE_DEMO_API="false"

# Server-side API proxy target. Docker Compose uses http://backend:3001.
ECHOMERE_BACKEND_ORIGIN="http://127.0.0.1:3001"
# Optional Host header override for unusual reverse-proxy deployments.
ECHOMERE_BACKEND_HOST=""
